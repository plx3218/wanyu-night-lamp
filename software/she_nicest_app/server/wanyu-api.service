[Unit]
Description=WANYU API server (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/wanyu
EnvironmentFile=/opt/wanyu/.env
ExecStart=/opt/wanyu/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
